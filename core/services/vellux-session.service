[Unit]
Description=Vellux Wayland Compositor Session
# Live (boot=live) oturumu: otomatik giris. Kurulu sistemde greetd calisir.
ConditionKernelCommandLine=boot=live
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
User=live
WorkingDirectory=/home/live
PAMName=login
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=Vellux
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/vellux-compositor
Restart=always
RestartSec=1
StandardInput=tty
StandardOutput=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=graphical.target
